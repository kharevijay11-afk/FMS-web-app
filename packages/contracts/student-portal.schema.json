{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "title":"Student-owned portal snapshot",
 "type":"object",
 "required":["source"],
 "properties":{
  "source":{"type":"string","enum":["synthetic","postgres"]},
  "status":{"type":"string","enum":["pending"]},"message":{"type":"string"},
  "asOf":{"type":"string","format":"date"},"unreadNoticeCount":{"type":"integer","minimum":0},
  "profile":{"type":"object","properties":{"mobile":{"type":["string","null"]},"email":{"type":["string","null"]},"address":{"type":["string","null"]},"photoUrl":{"type":"null"},"session":{"type":["string","null"]},"courseStartDate":{"type":["string","null"]},"courseEndDate":{"type":["string","null"]}}},
  "course":{"type":"object","properties":{"code":{"type":["string","null"]},"group":{"type":["string","null"]},"session":{"type":["string","null"]},"duration":{"type":["string","null"]},"batchTime":{"type":["string","null"]},"batchStatus":{"type":["string","null"]},"startDate":{"type":["string","null"]},"endDate":{"type":["string","null"]}}},
  "fee":{"type":"object","properties":{"courseFeePaise":{"$ref":"#/$defs/paise"},"addOnFeePaise":{"$ref":"#/$defs/paise"},"discountPaise":{"$ref":"#/$defs/paise"},"paymentStatus":{"type":"string"}}},
  "installments":{"type":"array","items":{"type":"object","required":["number","dueDate","plannedPaise","cumulativePlannedPaise","cumulativePaidPaise","remainingPaise","status"],"properties":{"number":{"type":"integer","minimum":1},"dueDate":{"type":"string","format":"date"},"plannedPaise":{"$ref":"#/$defs/paise"},"cumulativePlannedPaise":{"$ref":"#/$defs/paise"},"cumulativePaidPaise":{"$ref":"#/$defs/paise"},"remainingPaise":{"$ref":"#/$defs/paise"},"status":{"type":"string"}}}},
  "payments":{"type":"array","items":{"type":"object","required":["id","receiptNumber","date","amountPaise","mode","status","documentId"],"properties":{"id":{"type":"string"},"receiptNumber":{"type":"string"},"date":{"type":"string","format":"date"},"amountPaise":{"$ref":"#/$defs/paise"},"mode":{"type":"string"},"reference":{"type":["string","null"]},"status":{"const":"Posted"},"documentId":{"type":"string"}}}},
  "receipts":{"type":"array","items":{"type":"object","required":["id","receiptNumber","date","amountPaise","documentStatus"],"properties":{"id":{"type":"string"},"receiptNumber":{"type":"string"},"date":{"type":"string","format":"date"},"amountPaise":{"$ref":"#/$defs/paise"},"documentStatus":{"const":"pending"}}}},
  "dues":{"type":"object","properties":{"currentDuePaise":{"$ref":"#/$defs/nullablePaise"},"nextDueDate":{"type":["string","null"]},"nextCumulativeDuePaise":{"$ref":"#/$defs/nullablePaise"},"overdue":{"type":["boolean","null"]},"daysOverdue":{"type":["integer","null"],"minimum":0},"daysRemaining":{"type":["integer","null"]},"reminder":{"type":"string"}}},
  "notices":{"type":"array","items":{"$ref":"#/$defs/notice"}},
  "certificates":{"type":"array","items":{"type":"object","required":["type","eligibility","reason","issued"],"properties":{"type":{"type":"string"},"eligibility":{"type":"string"},"reason":{"type":"string"},"issued":{"type":"boolean"},"number":{"type":["string","null"]},"issueDate":{"type":["string","null"]},"thresholdPercent":{"type":["integer","null"]},"paymentGateMet":{"type":"boolean"}}}},
  "resources":{"type":"array","items":{"type":"object","required":["id","type","title","courseCode","session","date","description","downloadUrl"],"properties":{"id":{"type":"string"},"type":{"enum":["assignment","project","practical"]},"title":{"type":"string"},"courseCode":{"type":"string"},"session":{"type":"string"},"date":{"type":"string","format":"date"},"description":{"type":"string"},"downloadUrl":{"type":"null"}}}},
  "credentials":{"type":"object","additionalProperties":false,"required":["status","message"],"properties":{"status":{"const":"pending"},"message":{"type":"string"}}}
 },
 "$defs":{
  "paise":{"type":"integer","minimum":0,"maximum":9007199254740991},
  "nullablePaise":{"type":["integer","null"],"minimum":0,"maximum":9007199254740991},
  "notice":{"type":"object","required":["id","title","date","description","readAt","attachmentUrl"],"properties":{"id":{"type":"string"},"title":{"type":"string"},"date":{"type":"string","format":"date"},"description":{"type":"string"},"readAt":{"type":["string","null"],"format":"date-time"},"attachmentUrl":{"type":"null"}}}
 }
}
