NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://127.0.0.1:3000
# Required in production; use at least 32 random characters.
SESSION_SECRET=replace-with-a-long-random-production-secret
SESSION_TTL_SECONDS=3600
DATA_SOURCE=synthetic
DATABASE_URL=postgresql://fms_web_app:change-me@127.0.0.1:5432/fms_web_dev
DATABASE_SSL=false
DATABASE_SSL_VERIFY=true
DATABASE_SSL_CA_PATH=C:\secure\supabase-prod-ca.crt
TRUST_PROXY=false
TRUSTED_PROXY_ADDRESSES=
MFA_ENCRYPTION_KEY=replace-with-32-byte-base64-key
TOKEN_PEPPER=replace-with-a-long-random-token-pepper
AUDIT_IP_PEPPER=replace-with-a-long-random-audit-pepper
ACTIVATION_TTL_SECONDS=3600
RECOVERY_TTL_SECONDS=1800
MFA_CHALLENGE_TTL_SECONDS=300
LOGIN_WINDOW_SECONDS=900
LOGIN_MAX_ATTEMPTS=8
ACCOUNT_LOCK_SECONDS=900
